# TypeSafe (Jev) の API キー。console.typesafe.ai/settings/keys で発行する。
TYPESAFE_API_KEY=sk-...

# 任意。既定は jev-latest。
# TYPESAFE_DEFAULT_MODEL=jev-latest

# 任意。SDK のログレベル (debug/info/warn/error/off)。debug はリクエストボディも出力する。
# TYPESAFE_LOG_LEVEL=warn

# サーバ設定（任意）
# PORT=8080
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://yabu.me
# NOSTR_CONNECT_TIMEOUT_MS=3000
# NOSTR_MAX_WAIT_MS=5000
# JEV_CONCURRENCY=8
