{
  "name": "nostr-jev-timeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nostr のリレーから集めた投稿を Jev (TypeSafe System One) で選別し、おすすめ投稿の ID だけを返す HTTP API",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
